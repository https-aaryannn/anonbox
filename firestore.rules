rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Confessions: public can create (no auth), but must provide valid ownerUid
    // Reads/updates/deletes require auth + ownership.
    match /confessions/{confession} {
      allow create: if
        request.resource.data.ownerUid != null &&
        request.resource.data.ownerUid != '' &&
        request.resource.data.keys().hasOnly(['content', 'ownerUid', 'createdAt', 'read', 'archived']);

      allow read, update, delete: if
        request.auth != null &&
        resource.data.ownerUid == request.auth.uid;
    }

    // API keys: only the owning account can manage
    match /apiKeys/{keyDoc} {
      allow create: if
        request.auth != null &&
        request.auth.uid == request.resource.data.ownerUid;

      allow read, update, delete: if
        request.auth != null &&
        resource.data.ownerUid == request.auth.uid;
    }
  }
}