# Firebase Web SDK (used by the browser)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Vercel Serverless API (api/*.ts) - required for production
# 1. Generate a Firebase Admin service account JSON in the Firebase Console
#    (Project Settings > Service Accounts > Generate new private key)
# 2. Paste the ENTIRE JSON as a single line into Vercel Environment Variable:
#    FIREBASE_SERVICE_ACCOUNT_JSON
# 3. (Optional) Set CORS_ORIGIN to your Vercel deployment URL for stricter CORS
# CORS_ORIGIN=https://your-app.vercel.app

# Local development (node server/index.js) - optional alternative
# serviceAccount=./serviceAccount.json
# PORT=3001